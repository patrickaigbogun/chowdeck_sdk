{
  "name": "@chwdck/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Chowdeck (Merchant and Relay APIs)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src",
    "format": "biome check --write src",
    "tag": "bun scripts/tag.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "dokugen": "^14.0.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chowdeck",
    "sdk",
    "api",
    "nigeria",
    "food-delivery",
    "logistics"
  ],
  "author": "Chowdeck",
  "license": "MIT"
}
